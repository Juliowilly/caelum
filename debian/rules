#!/usr/bin/make -f
export PYBUILD_NAME=caelum
# tests/ is not part of the installed package; copy it next to the build so unittest finds it
export PYBUILD_BEFORE_TEST=cp -r {dir}/tests {build_dir}
export PYBUILD_AFTER_TEST=rm -rf {build_dir}/tests
export PYBUILD_TEST_ARGS=-s tests -v

%:
	dh $@ --buildsystem=pybuild
